# Local-only default. Do not expose this service through a public host or CLI.
PRIVATE_LOCAL_UI=1
# Temporary Cloudflare demo only. Admin paths remain loopback-only.
PUBLIC_CHAT_UI=0

# API 키는 fake 데모에서 비워 둔다.
ANTHROPIC_API_KEY=

# 지식베이스 디렉터리 — 이 값만 바꾸면 다른 분야 챗봇으로 전환된다.
KNOWLEDGE_DIR=knowledge

# Safe default. The approved one-week personal Mac setup overrides this with
# MODEL=codex-cli:gpt-5.6-luna on loopback only; the adapter pins high effort.
MODEL=fake
CODEX_MODEL=gpt-5.6-luna
MODEL_CHAIN=fake

# 리버스 프록시 hop 수 (X-Forwarded-For 신뢰 범위, rate limit에 사용)
TRUST_PROXY_HOPS=0

# 하루 최대 요청 수 캡
DAILY_REQUEST_CAP=500

# 관리자 통계 API 인증 토큰 — 비워두면 /api/stats는 fail-closed(503)
STATS_API_TOKEN=

# _privacy.md의 보관 기간과 반드시 같아야 합니다.
RETENTION_RAW_DAYS=90
RETENTION_SUMMARY_DAYS=365

# 연결 지도 후보의 최소 확인 수준: verified(기본, 사람의 전화·방문 확인)
# web은 공식 웹 확인 또는 사람 확인 기관을 포함합니다. 다른 값은 시작 오류입니다.
REFERRAL_MIN_CHECK=verified
